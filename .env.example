# Copy to .env (gitignored). Loaded by app/env.py (train_dpo, main).

# HuggingFace Hub token (required for upload; optional for download rate limits)
# HF_TOKEN=hf_...

# Upload trained adapter to this model repo after training
HF_REPO_ID=taixingbi/layer-router-dpo-v1

# Set to true for a private Hub repo
# HF_PRIVATE=false

# Use a free GPU when another process holds GPU 0 (e.g. vLLM)
# CUDA_VISIBLE_DEVICES=1

# Training (app/train_dpo.py — also reads os.environ / CLI flags)
# TRAIN_JSONL=./data/train.jsonl
# VAL_JSONL=./data/val.jsonl
# MAX_LENGTH=1024
# PER_DEVICE_TRAIN_BATCH_SIZE=1
# GRAD_ACCUM=8
# NUM_TRAIN_EPOCHS=2
# BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
