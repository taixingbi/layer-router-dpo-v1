# Copy to .env (gitignored). Loaded by app/env.py (train, main).

# Training method: dpo or sft
TRAIN_METHOD=dpo

# HuggingFace Hub token (required for upload; optional for download rate limits)
# HF_TOKEN=hf_...

# Full repo override (optional). If unset: {HF_TOKEN user}/{HF_REPO_FEATURE}-{model-slug}-{method}-{HF_REPO_VERSION}
# HF_REPO_ID=taixingbi/router-qwen2.5-1.5b-dpo-v1
# HF_REPO_ID=taixingbi/router-qwen2.5-1.5b-sft-v1

# Hub repo name parts (HF_REPO_MODEL derived from BASE_MODEL unless set)
HF_REPO_FEATURE=router
HF_REPO_VERSION=v1
# HF_REPO_MODEL=custom-slug

# Set to true for a private Hub repo
# HF_PRIVATE=false

# Use a free GPU when another process holds GPU 0 (e.g. vLLM)
# CUDA_VISIBLE_DEVICES=1

# Training (also available as CLI flags)
# TRAIN_JSONL=./data/dpo/train.jsonl
# VAL_JSONL=./data/dpo/val.jsonl
# MAX_LENGTH=1024
# PER_DEVICE_TRAIN_BATCH_SIZE=1
# GRAD_ACCUM=8
# NUM_TRAIN_EPOCHS=2
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
