# Copied to APP_DIR/.env on first deploy (gitignored locally).

# Training method: dpo or sft
TRAIN_METHOD=dpo

# HuggingFace Hub token (required for upload)
# HF_TOKEN=hf_...

# Full repo override (optional)
# HF_REPO_ID=taixingbi/router-qwen25-1.5b-dpo-v1
# HF_REPO_ID=taixingbi/router-qwen25-1.5b-sft-v1

# Hub repo name parts (defaults; also set via GitHub Actions variables)
HF_REPO_FEATURE=router
HF_REPO_MODEL=qwen25-1.5b
HF_REPO_VERSION=v1

# Set to true for a private Hub repo
# HF_PRIVATE=false

# Use a free GPU when another process holds GPU 0
# CUDA_VISIBLE_DEVICES=0

# Training overrides (also available as CLI flags)
# TRAIN_JSONL=./data/dpo/train.jsonl
# VAL_JSONL=./data/dpo/val.jsonl
MAX_LENGTH=1024
# PER_DEVICE_TRAIN_BATCH_SIZE=1
GRAD_ACCUM=8
NUM_TRAIN_EPOCHS=2
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
