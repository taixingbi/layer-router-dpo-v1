# Copied to APP_DIR/.env on first deploy (gitignored locally).

# HuggingFace Hub token (optional; avoids rate limits)
# HF_TOKEN=hf_...

# Use a free GPU when another process holds GPU 0
# CUDA_VISIBLE_DEVICES=0

# Training overrides (also available as CLI flags)
# TRAIN_JSONL=./data/train.jsonl
# VAL_JSONL=./data/val.jsonl
# MAX_LENGTH=1024
# PER_DEVICE_TRAIN_BATCH_SIZE=1
# GRAD_ACCUM=8
# NUM_TRAIN_EPOCHS=2
# BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
